---
import { Image } from "astro:assets";
import { MapPin, Phone, ShieldCheck, Mail } from "lucide-react";
import { FaWhatsapp, FaFacebookF, FaInstagram, FaTiktok, FaYoutube, FaXTwitter } from "react-icons/fa6";
import logoImg from "../assets/logo-header.webp";

const BRAND = "كور برو - Core Pro";
const PHONE = "01021507462";
const WHATSAPP = "https://wa.me/201021507462";
const EMAIL = "info@corepro-eg.com";
const ADDRESS = "الحي العاشر مدينة نصر - مصر";
const YEAR = new Date().getFullYear();
const SOCIAL_USER = "corproeg";

const SOCIAL = [
 { name: "Facebook", href: `https://www.facebook.com/${SOCIAL_USER}`, icon: FaFacebookF },
 { name: "Instagram", href: `https://www.instagram.com/${SOCIAL_USER}`, icon: FaInstagram },
 { name: "TikTok", href: `https://www.tiktok.com/@${SOCIAL_USER}`, icon: FaTiktok },
 { name: "YouTube", href: `https://www.youtube.com/@${SOCIAL_USER}`, icon: FaYoutube },
 { name: "X", href: `https://x.com/${SOCIAL_USER}`, icon: FaXTwitter },
];
---

<footer class="relative mt-20 border-t border-black/10 bg-slate-950 text-white pb-40 md:pb-24">
 <div class="mx-auto max-w-6xl px-4 py-14">
 <div class="grid gap-10 md:grid-cols-4">
 <div>
 <div class="flex items-center gap-3">
 <div class="h-12 w-12 rounded-2xl bg-white border border-black/10 shadow-sm grid place-items-center overflow-hidden">
 <Image
 src={logoImg}
 alt={`${BRAND} logo`}
 width={40}
 height={40}
 class="h-10 w-auto object-contain"
 loading="lazy"
 />
 </div>
 <div class="text-lg font-extrabold">{BRAND}</div>
 </div>

 <p class="mt-4 text-white/85 leading-7">
 شركة متخصصة في قص الخرسانة بالمنشار، تخريم الكور، واير تقطيع خرسانة، وتركيب الشفاطات داخل القاهرة والجيزة. دقة هندسية وأمان كامل في التنفيذ.
 </p>

 <div class="mt-5 space-y-2 text-sm text-white/85">
 <div class="flex items-center gap-2">
 <MapPin className="h-4 w-4 text-white/80" />
 <span>{ADDRESS}</span>
 </div>
 <div class="flex items-center gap-2">
 <Phone className="h-4 w-4 text-white/80" />
 <a class="hover:text-white underline-offset-4 hover:underline" href={`tel:${PHONE}`}>{PHONE}</a>
 </div>
 <div class="flex items-center gap-2">
 <Mail className="h-4 w-4 text-white/80" />
 <a class="hover:text-white underline-offset-4 hover:underline" href={`mailto:${EMAIL}`}>{EMAIL}</a>
 </div>
 </div>

 <div class="mt-6">
 <div class="text-sm font-extrabold text-white mb-3">تواصل معنا</div>
 <div class="flex flex-wrap gap-2">
 {SOCIAL.map((s) => (
 <a
 href={s.href}
 target="_blank"
 rel="noopener noreferrer"
 aria-label={s.name}
 class="inline-flex items-center justify-center h-11 w-11 rounded-2xl border border-white/15 bg-white/5 hover:bg-white/10 hover:border-white/25 transition"
 >
 <s.icon className="h-4 w-4" />
 </a>
 ))}
 </div>
 <div class="mt-3 text-xs text-white/70">@{SOCIAL_USER}</div>
 </div>
 </div>

 <div>
 <div class="text-lg font-extrabold mb-4">الخدمات</div>
 <div class="space-y-2 text-sm text-white/85">
 <a href="/core" class="block hover:text-white transition">تخريم الخرسانة بالكور</a>
 <a href="/saw" class="block hover:text-white transition">قص الخرسانة بالمنشار</a>
 <a href="/wire" class="block hover:text-white transition">واير تقطيع خرسانة</a>
 <a href="/hoods" class="block hover:text-white transition">تركيب الشفاطات</a>
 <a href="/concrete-cutting-alexandria" class="block hover:text-white transition">قص خرسانة الإسكندرية</a>
 <a href="/gas-holes" class="block hover:text-white transition">فتحات الغاز الطبيعي</a>
 <a href="/wall-cutting" class="block hover:text-white transition">قص وفتح الجدران</a>
 <a href="/ceiling-holes" class="block hover:text-white transition">فتحات الأسقف</a>
 <a href="/gypsum-holes" class="block hover:text-white transition">فتحات الجبس</a>
 <a href="/sewer-holes" class="block hover:text-white transition">فتحات السباكة</a>
 <a href="/electrical-holes" class="block hover:text-white transition">فتحات الكهرباء</a>
 </div>
 </div>

 <div>
 <div class="text-lg font-extrabold mb-4">الشركة</div>
 <div class="space-y-2 text-sm text-white/85">
 <a href="/contractor" class="block hover:text-white transition text-emerald-400 font-bold">مقاولات للشركات</a>
 <a href="/track-saw" class="block hover:text-white transition">منشار قص الخرسانة</a>
 <a href="/projects" class="block hover:text-white transition">سابقة الأعمال</a>
 <a href="/prices" class="block hover:text-white transition">الأسعار</a>
 <a href="/about" class="block hover:text-white transition">من نحن</a>
 <a href="/privacy-policy" class="block hover:text-white transition">سياسة الخصوصية</a>
 <a href="/terms" class="block hover:text-white transition">شروط الاستخدام</a>
 <a href="/blog" class="block hover:text-white transition">المدونة</a>
 </div>
 </div>

 <div>
 <div class="text-lg font-extrabold mb-4">احجز معاينة الآن</div>
 <div class="space-y-3">
 <a href={`tel:${PHONE}`} class="flex items-center justify-center gap-2 rounded-2xl bg-white text-slate-900 py-3 font-extrabold hover:bg-slate-200 transition" aria-label="اتصال مباشر">
 <Phone className="h-4 w-4" />
 اتصال مباشر
 </a>
 <a href={WHATSAPP} class="flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 py-3 font-extrabold hover:bg-emerald-700 transition" aria-label="محادثة واتساب">
 <FaWhatsapp className="h-4 w-4" />
 واتساب
 </a>
 </div>
 <div class="mt-6 flex items-start gap-2 text-sm text-white/85">
 
 تنفيذ آمن بدون اهتزاز أو تكسير عشوائي.
 </div>
 </div>
 </div>

 <div class="mt-12 border-t border-white/10 pt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-sm text-white/85">
 <div> {YEAR} {BRAND}. جميع الحقوق محفوظة.</div>
 <div class="flex flex-wrap gap-4">
 <a href="/" class="hover:text-white transition">الرئيسية</a>
 <a href="/core" class="hover:text-white transition">الكور</a>
 <a href="/saw" class="hover:text-white transition">القص</a>
 <a href="/wire" class="hover:text-white transition">الواير</a>
 <a href="/hoods" class="hover:text-white transition">الشفاطات</a>
 <a href="/projects" class="hover:text-white transition">المشاريع</a>
 <a href="/prices" class="hover:text-white transition">الأسعار</a>
 </div>
 </div>
 </div>
</footer>

---
import { Image } from 'astro:assets';
import { Phone, Menu, ArrowLeft, ChevronDown, MapPin } from 'lucide-react';
import logoImg from '../assets/logo-header.webp';
import { getPageContact } from '../lib/contact';
const { currentPath = Astro.url.pathname } = Astro.props;
const contact = getPageContact(currentPath);
const nav = [
  { href: '/', label: 'الرئيسية' }, { href: '/core', label: 'تخريم الكور' },
  { href: '/saw', label: 'قص الخرسانة' }, { href: '/wire', label: 'الواير الماسي' },
  { href: '/hoods', label: 'الشفاطات' }, { href: '/projects', label: 'أعمالنا' },
];
const extra = [
  { href: '/prices', label: 'الأسعار وطلب الخدمة' }, { href: '/contractor', label: 'مقاولات الشركات' },
  { href: '/blog', label: 'المدونة والأدلة' }, { href: '/glossary', label: 'دليل المصطلحات' },
  { href: '/about', label: 'عن كور برو' }, { href: '/privacy-policy', label: 'سياسة الخصوصية' },
  { href: '/terms', label: 'شروط الاستخدام' },
];
const active = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
---
<div class="cp-topbar"><div class="cp-wrap"><span>من أول مقاس… إلى آخر تفصيلة.</span><a href={`tel:${contact.international}`}><Phone size={12} /><bdi>{contact.phone}</bdi></a><span class="cp-topbar-location"><MapPin size={12} />مدينة نصر · تأكيد التغطية حسب موقع المشروع</span></div></div>
<header class="cp-header"><div class="cp-wrap cp-navbar">
  <a href="/" class="cp-brand" aria-label="كور برو، الصفحة الرئيسية"><Image src={logoImg} alt="شعار كور برو" width={45} height={60} loading="eager" /><span><b dir="ltr">Core<span>Pro</span><i>.</i></b><small>حلول قص وتخريم الخرسانة</small></span></a>
  <button id="cp-menu-toggle" class="cp-menu-toggle" type="button" aria-label="فتح القائمة" aria-controls="cp-navigation" aria-expanded="false"><Menu size={23} /></button>
  <nav id="cp-navigation" class="cp-navigation" aria-label="التنقل الرئيسي">
    {nav.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
    <details class="cp-nav-more"><summary>المزيد<ChevronDown size={14} /></summary><div>{extra.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}</div></details>
    <a class="cp-nav-mobile-call" href={`tel:${contact.international}`}>اتصل: <bdi>{contact.phone}</bdi></a>
  </nav>
  <div class="cp-nav-actions"><a class="cp-phone-icon" href={`tel:${contact.international}`} aria-label={`اتصال ${contact.phone}`}><Phone size={19} /></a><a class="cp-btn cp-btn-orange" href={currentPath === '/' ? '#quote' : contact.whatsapp}>اطلب مراجعة مشروعك<ArrowLeft size={17} /></a></div>
</div></header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#cp-menu-toggle');
  const navigation = document.querySelector<HTMLElement>('#cp-navigation');
  const more = navigation?.querySelector('details');
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'فتح القائمة');
    navigation?.classList.remove('is-open'); if (more) more.open = false;
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
    navigation?.classList.toggle('is-open', open);
  });
  navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape') { const wasOpen = toggle?.getAttribute('aria-expanded') === 'true'; closeMenu(); if (wasOpen) toggle?.focus(); } });
  document.addEventListener('click', event => { if (!(event.target as Element).closest('.cp-header')) closeMenu(); });
</script>

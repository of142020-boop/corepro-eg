---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
 Sparkles, ShieldCheck, Target, CheckCircle2, ArrowRight,
 MapPin, Wrench, Ruler, Building2, Fan, Hammer, BadgeCheck,
 Layers, Gauge, Cable
} from "lucide-react";
import heroImg from '../../assets/images/home/sharikat-kas-kharsana.webp';
import sawImg from '../../assets/images/home/kas-kharsana-menshar-masy.webp';
import coreImg from '../../assets/images/home/sanayeh-core.webp';
import hoodsImg from '../../assets/images/home/tarkib-shafat-matbakh.webp';

const BRAND = "كور برو - Core Pro";
const DOMAIN = "https://corepro-eg.com";
const PHONE = "01021507462";
const PHONE_INT = "+201021507462";
const WHATSAPP = "https://wa.me/201021507462";
const ADDRESS_TEXT = "القاهرة الكبرى";

const faq = [
 {
 q: 'ما الفرق بين "الكور" و "قص الخرسانة"؟',
 a: "يُستخدم تخريم الكور لعمل فتحات دائرية لتمرير الخدمات، بينما ينفذ المنشار قطوعاً مستقيمة لفتح الأبواب والنوافذ أو تعديل البلاطات. تحدد طبيعة العنصر وموافقة المهندس متطلبات أي تعديل إنشائي.",
 },
 {
 q: "هل تقومون بتركيب شفاط توشيبا وتأسيس الفتحة له؟",
 a: "نعم، نراجع موديل الشفاط وتعليمات الشركة المصنّعة لتحديد مقاس الفتحة ومسار الدكت. يشمل تركيب الشفاط والتشطيب نطاق العمل المتفق عليه، لذلك أرسل صورة الجهاز والموقع قبل الحجز.",
 },
 {
 q: "هل العمل يسبب غباراً في الشقة المفروشة؟",
 a: "يُستخدم التبريد بالماء في كثير من أعمال القص والتخريم، ما يساعد على خفض الغبار لكنه ينتج مياه وصوتاً ومخلفات. نراجع حماية الأثاث والتشطيبات واحتواء المياه قبل تحديد مدى ملاءمة العمل في شقة مأهولة.",
 },
 {
 q: "كيف يتم تحديد السعر؟",
 a: "يتحدد السعر حسب نوع الخدمة ومقاسات القص أو الفتحات وسماكة الخرسانة وعددها وموقع العمل ومتطلبات التجهيز. أرسل صورة ومقاسات الموقع للحصول على تقدير بعد مراجعة التفاصيل.",
 },
];

const jsonLd = [
 {
 "@context": "https://schema.org",
 "@type": "LocalBusiness",
 name: BRAND,
 url: DOMAIN,
 logo: `${DOMAIN}/logo-header-116x154.webp`,
 telephone: PHONE_INT,
 address: {
 "@type": "PostalAddress",
 addressCountry: "EG",
 addressLocality: "Cairo",
 streetAddress: ADDRESS_TEXT,
 },
 },
 {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 mainEntity: faq.map((x) => ({
 "@type": "Question",
 name: x.q,
 acceptedAnswer: { "@type": "Answer", text: x.a },
 })),
 },
 {
 "@context": "https://schema.org",
 "@type": "WebPage",
 url: DOMAIN,
 speakable: {
 "@type": "SpeakableSpecification",
 cssSelector: ["#faq", "h1"],
 },
 }
];
---

<div class="bg-slate-50">
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

 {/* HERO */}
 <section class="relative overflow-hidden">
 <div class="absolute inset-0 bg-[radial-gradient(1200px_circle_at_20%_10%,rgba(59,130,246,0.16),transparent_55%),radial-gradient(900px_circle_at_80%_20%,rgba(16,185,129,0.14),transparent_55%)]"></div>
 <div class="absolute inset-0 bg-gradient-to-b from-white via-slate-50 to-slate-50"></div>

 <div class="relative mx-auto max-w-6xl px-4 pt-10 pb-10 md:pt-16 md:pb-14">
 <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
 <div>
 <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white/80 px-4 py-2 text-sm text-slate-700 shadow-sm">
 
 <span>قص خرسانة · تخريم كور · تركيب شفاطات</span>
 </div>

 <h1 class="mt-4 text-3xl md:text-5xl font-extrabold leading-tight text-slate-900">
  قص وتخريم الخرسانة في مصر | كور برو - 01021507462
 </h1>

 <p class="mt-3 text-lg md:text-xl font-bold text-slate-700">
  قص بالمنشار الماسي | تخريم كور | تركيب شفاطات
 </p>

 <p class="mt-5 text-slate-700 leading-8">
 <strong>{BRAND}</strong> تقدم خدمات قص الخرسانة بالمنشار والواير، وتخريم الكور، وتركيب الشفاطات. أرسل نوع العمل ومقاساته وموقعه لمراجعة طريقة التنفيذ والتكلفة قبل الحجز.
 </p>

 <div class="mt-6 grid gap-3 md:grid-cols-3">
 <div class="flex items-center justify-center gap-2 rounded-2xl border border-black/10 bg-white/70 px-4 py-3 text-sm text-slate-800 shadow-sm">
 
 <span class="text-slate-700">تحديد نطاق العمل</span>
 </div>
 <div class="flex items-center justify-center gap-2 rounded-2xl border border-black/10 bg-white/70 px-4 py-3 text-sm text-slate-800 shadow-sm">
 
 <span class="text-slate-700">مراجعة المقاسات</span>
 </div>
 <div class="flex items-center justify-center gap-2 rounded-2xl border border-black/10 bg-white/70 px-4 py-3 text-sm text-slate-800 shadow-sm">
  <span class="text-slate-700">تأكيد التغطية</span>
 </div>
 </div>

 <div class="mt-7">
 <a href="#cta" class="inline-flex items-center justify-center rounded-2xl border border-black/10 bg-white px-5 py-3 font-bold text-slate-900 shadow-sm hover:bg-slate-50 transition">
 اطلب عرض سعر
 </a>
 </div>

 <div class="mt-4 flex items-center gap-2 text-sm text-slate-600">
 <MapPin className="h-4 w-4" />
 <span>نخدم: {ADDRESS_TEXT} والجيزة والمدن الجديدة</span>
 </div>
 </div>

 {/* HERO IMAGE OPTIMIZED */}
 <div class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl shadow-[0_16px_60px_rgba(0,0,0,0.08)] overflow-hidden">
 <div class="relative aspect-square bg-slate-100 max-w-[1024px] mx-auto">
 <Picture
 src={heroImg}
 widths={[400, 800, 1024]}
 sizes="(max-width: 640px) 400px, 1024px"
 alt={`${BRAND} - قص وتخريم الخرسانة وتركيب الشفاطات`}
 loading="eager"
 fetchpriority="high"
 class="object-cover h-full w-full"
 />
 </div>
 <div class="p-5 grid gap-3 md:grid-cols-3">
 <div class="rounded-2xl border border-black/10 bg-white p-4">
 <div class="font-bold text-slate-900 flex items-center gap-2">
 
 قص بالمنشار
 </div>
 <p class="mt-2 text-slate-600 leading-7">فتح أبواب/شبابيك وخطوط مستقيمة.</p>
 </div>
 <div class="rounded-2xl border border-black/10 bg-white p-4">
 <div class="font-bold text-slate-900 flex items-center gap-2">
  تخريم كور
 </div>
 <p class="mt-2 text-slate-600 leading-7">فتحات دائرية للتمديدات وفق المقاسات المطلوبة.</p>
 </div>
 <div class="rounded-2xl border border-black/10 bg-white p-4">
 <div class="font-bold text-slate-900 flex items-center gap-2">
 
 شفاطات
 </div>
 <p class="mt-2 text-slate-600 leading-7">تركيب/تأسيس دكت/صيانة.</p>
 </div>
 </div>
 </div>
 </div>

 {/* Services Grid */}
 <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
 {[
 {
 title: "قص الخرسانة بالمنشار",
 desc: "قص مستقيم لفتح الأبواب والنوافذ وتعديل الجدران أو البلاطات بعد مراجعة الموقع.",
 bullets: ["قص الجدار لفتحات الأبواب والنوافذ.", "قص البلاطات بعد اعتماد المخططات الإنشائية.", "اختيار المنشار اليدوي أو المثبت على سكة."],
 href: "/saw",
 icon: Hammer, icColor: "text-amber-600",
 imgSrc: sawImg, imgStr: false
 },
 {
 title: "تخريم الخرسانة بالكور",
 desc: "تخريم دائري في الخرسانة لتمرير خطوط الخدمات وفق المقاس وظروف الموقع.",
 bullets: ["فتحات التكييف والتهوية بحسب متطلبات التركيب.", "فتحات الغاز بعد تحديد مسار ومقاس التمديد.", "فتحات السباكة والصرف وفق مقاس الماسورة."],
 href: "/core",
 icon: Ruler, icColor: "text-sky-600",
 imgSrc: coreImg, imgStr: false
 },
 {
 title: "تركيب الشفاطات والتهوية",
 desc: "تركيب شفاطات المطبخ والحمام مع مراجعة مقاس الفتحة ومسار الدكت.",
 bullets: ["تركيب بلت ان/هرمي/مسطح/شباك.", "حلول بمدخنة أو فلتر كربوني.", "تركيب شفاطات حمام سقفية."],
 href: "/hoods",
 icon: Fan, icColor: "text-emerald-600",
 imgSrc: hoodsImg, imgStr: false
 },
 {
 title: "قص بالواير الماسي",
 desc: "لقطع بعض الكتل والعناصر الكبيرة عندما تسمح ظروف الوصول والتثبيت بذلك.",
 bullets: ["تقييم سماكة العنصر ومساحة العمل قبل التنفيذ.", "مراجعة المخططات للعناصر الإنشائية.", "التخطيط لتثبيت الجزء المفصول ورفعه."],
 href: "/wire",
 icon: Cable, icColor: "text-emerald-600",
 imgSrc: "/images/wire/wire-takteaa-kharsana.webp", imgStr: true
 }
 ].map((s) => (
 <div class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl shadow-sm overflow-hidden">
 <div class="relative aspect-[4/3] bg-white overflow-hidden">
 {s.imgStr ? (
 <img
 src={s.imgSrc as string}
 alt={s.title}
 width={660}
 height={440}
 class="object-contain bg-white p-4 h-full w-full"
 loading="lazy"
 />
 ) : (
 <Image
 src={s.imgSrc as ImageMetadata}
 alt={s.title}
 width={660}
 height={440}
 format="webp"
 quality={80}
 class="object-contain bg-white p-4 h-full w-full"
 />
 )}
 </div>
 <div class="p-6">
 <div class="font-extrabold text-lg text-slate-900">{s.title}</div>
 <p class="mt-3 text-slate-600 leading-7">{s.desc}</p>
 <ul class="mt-4 space-y-2">
 {s.bullets.map((b) => (
 <li class="flex gap-2">
 
 <span class="text-slate-600 leading-7">{b}</span>
 </li>
 ))}
 </ul>
 <a href={s.href} class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-black/10 bg-white px-5 py-3 font-bold text-slate-900 hover:bg-slate-50 transition">
 تفاصيل الخدمة
 <ArrowRight className="h-5 w-5" />
 </a>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 {/* Projects Banner */}
 <div class="mx-auto max-w-6xl px-4 pb-14 mt-10">
 <section class="relative rounded-[3rem] bg-slate-900 text-white overflow-hidden shadow-2xl">
 <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.8),transparent_70%)]"></div>
 <div class="relative z-10 p-10 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8">
 <div class="max-w-2xl">
 <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 text-emerald-300 font-bold mb-6 text-sm border border-emerald-500/30">
 <BadgeCheck className="w-4 h-4" />
 أعمال حقيقية على أرض الواقع
 </div>
 <h2 class="text-3xl md:text-5xl font-black mb-4 leading-tight">تصفح سابقة أعمالنا في المشاريع الكبرى</h2>
 <p class="text-slate-300 text-lg md:text-xl leading-relaxed">
  شاهد أمثلة على أعمال قص وتخريم الخرسانة وتركيب الشفاطات، وتعرّف على أنواع الخدمات التي ننفذها.
 </p>
 </div>
 <a href="/projects" class="shrink-0 inline-flex items-center gap-3 bg-emerald-600 hover:bg-emerald-500 transition-colors text-white px-8 py-4 rounded-2xl font-black text-xl shadow-[0_0_40px_rgba(16,185,129,0.3)] group">
 شاهد المشاريع الآن
 <ArrowRight className="w-6 h-6 rotate-180 group-hover:-translate-x-2 transition-transform" />
 </a>
 </div>
 </section>
 </div>

 {/* Other Sections */}
 <div class="mx-auto max-w-6xl px-4 pb-14 space-y-6">
 {/* Why Choose Us */}
  <section id="request-details" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
 <div class="mb-6 flex items-start gap-3">
 
 <div>
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">ما المعلومات المطلوبة لطلب الخدمة؟</h2>
  <p class="mt-2 text-slate-600 leading-7">تساعد هذه التفاصيل على تقييم طريقة التنفيذ والتكلفة قبل تحديد الموعد.</p>
 </div>
 </div>
 <div class="grid gap-3 md:grid-cols-2">
 {[
   { name: "نوع الخدمة", href: null },
   { name: "المقاسات وسماكة الخرسانة", href: null },
   { name: "صورة أو مخطط للموقع", href: null },
   { name: "عنوان المشروع وموعده", href: null },
 ].map((x) => (
    <div class="flex items-center gap-2 rounded-2xl border border-black/10 bg-white p-4">
      <span class="text-slate-700">{x.name}</span>
    </div>
 ))}
 </div>
 </section>

 {/* Areas */}
 <section id="areas" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
 <div class="mb-6 flex items-start gap-3">
 <div>
 <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">مناطق الخدمة (الأكثر طلباً)</h2>
 <p class="mt-2 text-slate-600 leading-7">اضغط على منطقتك لمعرفة التفاصيل الخاصة بها</p>
 </div>
 </div>
 <div class="grid gap-3 md:grid-cols-2">
 {[
  { name: "التجمع الخامس والقاهرة الجديدة", href: "/concrete-cutting-tagamoa" },
  { name: "6 أكتوبر والشيخ زايد", href: "/concrete-cutting-october" },
  { name: "الإسكندرية والساحل الشمالي", href: "/concrete-cutting-alexandria" },
  { name: "مدينة نصر ومصر الجديدة", href: null },
  { name: "المعادي والشروق ومدينتي", href: null },
  { name: "العاصمة الإدارية الجديدة", href: "/concrete-cutting-new-capital" },
 ].map((x) => (
  x.href ? (
    <a href={x.href} class="flex items-center justify-between rounded-2xl border border-emerald-500/30 bg-emerald-50/50 p-4 hover:bg-emerald-50 transition group">
      <span class="text-emerald-800 font-extrabold">{x.name}</span>
      <ArrowRight className="h-4 w-4 text-emerald-600 rotate-180 group-hover:-translate-x-1 transition-transform" />
    </a>
  ) : (
    <div class="flex items-center gap-2 rounded-2xl border border-black/10 bg-white p-4">
      <span class="text-slate-700">{x.name}</span>
    </div>
  )
 ))}
 </div>
 </section>

   {/* Service contact directory */}
  <section id="directory" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
    <div class="mb-6 flex items-start gap-3">
      <div>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">التواصل حسب نوع الخدمة</h2>
        <p class="mt-2 text-slate-600 leading-7">رقم التواصل ورابط تفاصيل كل خدمة</p>
      </div>
    </div>
    
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-right text-slate-800 min-w-[500px]">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="p-4 font-black text-slate-900">الخدمة المطلوبة</th>
            <th class="p-4 font-black text-slate-900 border-r border-slate-200">رقم التواصل المباشر</th>
            <th class="p-4 font-black text-slate-900 border-r border-slate-200">التفاصيل</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-bold">
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">صنايعي كور / فني تخريم</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/core" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">تخريم بالكور</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">شركة تخريم خرسانة / شركة قص خرسانة</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/contractor" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">مقاولات الشركات</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">عمل فتحات كور خرسانة</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/core" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">تفاصيل الفتحات</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">مقاول قص خرسانه / مقاول فتحات كور</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/contractor" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">طلب مقايسة مشروع</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">منشار قص الخرسانة (Track Saw)</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/track-saw" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">قص مستقيم بالمنشار</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">فني تركيب شفاطات مطبخ / حمام</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01015218216" class="hover:underline">01015218216</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/hoods" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">تركيب وتأسيس شفاطات</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

 {/* FAQ */}
 <section id="faq" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">أسئلة شائعة عن القص والتخريم والشفاطات</h2>
  <div class="mt-6 space-y-4">
  {faq.map((item) => (
  <details class="rounded-2xl border border-black/10 bg-white p-5">
    <summary class="cursor-pointer font-bold text-slate-900">{item.q}</summary>
    <p class="mt-4 text-slate-700 leading-8">{item.a}</p>
  </details>
  ))}
  </div>
 <div class="grid gap-4 md:grid-cols-2 md:items-center">
 <div class="text-slate-700 leading-8">
  <p><strong>{BRAND}</strong> تقدم خدمات قص الخرسانة وتخريم الكور وتركيب الشفاطات. أرسل نوع العمل ومقاساته وموقعه لمراجعة نطاق التنفيذ.</p>
  <p class="mt-3">تُحدد تكلفة العمل بعد مراجعة تفاصيل الموقع والخدمة المطلوبة.</p>
 </div>
 <div class="rounded-3xl border border-black/10 bg-white p-6">
  <div class="font-extrabold text-slate-900">للتواصل وتأكيد التغطية</div>

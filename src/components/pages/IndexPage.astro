---
import { Image } from 'astro:assets';
import CoreBlueprint from '../design/CoreBlueprint.astro';
import QuickQuote from '../design/QuickQuote.astro';
import {
 ShieldCheck, Target, ArrowRight, MapPin, Wrench, Ruler, Building2,
 Fan, Hammer, Layers, Cable, ArrowLeft, Drill, ClipboardCheck, HardHat
} from "lucide-react";
import coreImg from '../../assets/images/home/sanayeh-core.webp';
import hoodsImg from '../../assets/images/home/tarkib-shafat-matbakh.webp';

const BRAND = "كور برو - Core Pro";
const DOMAIN = "https://corepro-eg.com";
const PHONE = "01021507462";
const PHONE_INT = "+201021507462";
const ADDRESS_TEXT = "القاهرة الكبرى";

const faq = [
 {
 q: 'ما الفرق بين "الكور" و "قص الخرسانة"؟',
 a: "يُستخدم تخريم الكور لعمل فتحات دائرية لتمرير الخدمات، بينما ينفذ المنشار قطوعاً مستقيمة لفتح الأبواب والنوافذ أو تعديل البلاطات. تحدد طبيعة العنصر وموافقة المهندس متطلبات أي تعديل إنشائي.",
 },
 {
 q: "هل تقومون بتركيب شفاط توشيبا وتأسيس الفتحة له؟",
 a: "نعم، نراجع موديل الشفاط وتعليمات الشركة المصنّعة لتحديد مقاس الفتحة ومسار الدكت. يشمل تركيب الشفاط والتشطيب نطاق العمل المتفق عليه، لذلك أرسل صورة الجهاز والموقع قبل الحجز.",
 },
 {
 q: "هل العمل يسبب غباراً في الشقة المفروشة؟",
 a: "يُستخدم التبريد بالماء في كثير من أعمال القص والتخريم، ما يساعد على خفض الغبار لكنه ينتج مياه وصوتاً ومخلفات. نراجع حماية الأثاث والتشطيبات واحتواء المياه قبل تحديد مدى ملاءمة العمل في شقة مأهولة.",
 },
 {
 q: "كيف يتم تحديد السعر؟",
 a: "يتحدد السعر حسب نوع الخدمة ومقاسات القص أو الفتحات وسماكة الخرسانة وعددها وموقع العمل ومتطلبات التجهيز. أرسل صورة ومقاسات الموقع للحصول على تقدير بعد مراجعة التفاصيل.",
 },
];

const jsonLd = [
 {
 "@context": "https://schema.org",
 "@type": "LocalBusiness",
 name: BRAND,
 url: DOMAIN,
 logo: `${DOMAIN}/logo-header-116x154.webp`,
 telephone: PHONE_INT,
 address: {
 "@type": "PostalAddress",
 addressCountry: "EG",
 addressLocality: "Cairo",
 streetAddress: ADDRESS_TEXT,
 },
 },
 {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 mainEntity: faq.map((x) => ({
 "@type": "Question",
 name: x.q,
 acceptedAnswer: { "@type": "Answer", text: x.a },
 })),
 },
 {
 "@context": "https://schema.org",
 "@type": "WebPage",
 url: DOMAIN,
 speakable: {
 "@type": "SpeakableSpecification",
 cssSelector: ["#faq", "h1"],
 },
 }
];
---

<div class="cp-home">
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
 <section class="cp-hero"><div class="cp-wrap">
   <div class="cp-hero-grid">
     <div class="cp-hero-copy cp-reveal">
       <div class="cp-hero-badge"><span class="cp-live-dot"></span>المقاس الصحيح. المعدة المناسبة. تنفيذ مدروس.</div>
       <h1>قص وتخريم الخرسانة <br />في مصر <span class="cp-hero-brand">| كور برو</span> <span class="cp-hero-contact">- <bdi>01021507462</bdi></span></h1>
       <p>من فتحة كور لتمرير الخدمات، إلى قص الجدران والبلاطات بالمنشار والواير الماسي. نراجع طبيعة العنصر والمقاسات وظروف الموقع قبل تحديد طريقة التنفيذ والتكلفة.</p>
       <div class="cp-actions"><a class="cp-btn cp-btn-orange" href="#quote">ناقش تفاصيل مشروعك<ArrowLeft size={18} /></a><a class="cp-btn cp-btn-outline" href="/projects">استكشف أعمالنا<Building2 size={18} /></a></div>
       <div class="cp-hero-proof"><ShieldCheck size={17} />مراجعة الموقع · نطاق عمل واضح · تجهيز قبل التنفيذ</div>
     </div>
     <div class="cp-reveal"><CoreBlueprint /></div>
   </div>
   <div class="cp-metrics"><div class="cp-metric"><Ruler size={25} /><div><b>كل فتحة بمقاسها</b><p>القطر والسماكة والاستخدام</p></div></div><div class="cp-metric"><Target size={25} /><div><b>الطريقة تناسب العنصر</b><p>كور أو منشار أو واير ماسي</p></div></div><div class="cp-metric"><ClipboardCheck size={25} /><div><b>تجهيز ومراجعة مسبقة</b><p>تثبيت المعدة وحماية الموقع</p></div></div></div>
 </div></section>
 <div class="cp-industries"><div class="cp-wrap"><span>حلول حسب احتياج المشروع</span><span><Building2 size={19} />مبانٍ سكنية وفلل</span><span><Wrench size={19} />تمديدات وخدمات</span><span><Layers size={19} />جدران وأسقف وبلاطات</span><span><HardHat size={19} />شركات ومقاولات</span></div></div>
 <section class="cp-section cp-wrap" id="services">
   <div class="cp-section-head cp-reveal"><div><p class="cp-eyebrow">خدماتنا المتخصصة</p><h2 class="cp-title">الخدمة الصحيحة،<br />تبدأ من فهم المطلوب.</h2></div><p class="cp-intro">أربع خدمات رئيسية، ولكل خدمة متطلبات مختلفة. اختر نوع العمل لتتعرف على طريقة التجهيز والمعلومات المطلوبة قبل الحجز.</p></div>
   <div class="cp-bento">
     <article class="cp-service cp-reveal"><span class="cp-service-no">01 /</span><div class="cp-service-icon"><Drill size={23} /></div><h3>تخريم الخرسانة بالكور</h3><p>فتحات دائرية للغاز والسباكة والتكييف والتهوية، بالقطر المناسب للتمديدات وبعد مراجعة موضع الفتحة.</p><div class="cp-service-photo"><Image src={coreImg} alt="معدات تخريم الخرسانة بالكور" width={620} height={400} format="webp" loading="lazy" /></div><a class="cp-text-link" href="/core">تفاصيل خدمة تخريم الكور<ArrowLeft size={17} /></a></article>
     <article class="cp-service cp-reveal"><span class="cp-service-no">02 /</span><div class="cp-service-icon"><Hammer size={23} /></div><h3>قص الخرسانة بالمنشار</h3><p>قطوع مستقيمة لفتح الأبواب والنوافذ وتعديل الجدران والبلاطات، بعد مراجعة المخططات واعتماد التعديل الإنشائي.</p><a class="cp-text-link" href="/saw">تعرف على أعمال المنشار<ArrowLeft size={17} /></a></article>
     <article class="cp-service cp-reveal"><span class="cp-service-no">03 /</span><div class="cp-service-icon"><Cable size={23} /></div><h3>قص بالواير الماسي</h3><p>حل لبعض الكتل والقواعد والعناصر الكبيرة، وفق إمكانية الوصول والتثبيت وخطة التحكم في الجزء المفصول ورفعه.</p><a class="cp-text-link" href="/wire">متى يناسبك الواير؟<ArrowLeft size={17} /></a></article>
     <article class="cp-service cp-reveal"><span class="cp-service-no">04 /</span><div class="cp-service-small"><div><div class="cp-service-icon"><Fan size={23} /></div><h3>تأسيس وتركيب شفاط المطبخ</h3><p>مراجعة موديل الجهاز ومقاس الفتحة ومسار الهواء، وتنسيق التأسيس مع التشطيبات. قسم الشفاطات له رقم تواصل مخصص.</p><a class="cp-text-link" href="/hoods">تفاصيل التركيب والتأسيس<ArrowLeft size={17} /></a></div><Image src={hoodsImg} alt="تأسيس وتركيب شفاط المطبخ" width={230} height={220} format="webp" loading="lazy" /></div></article>
   </div>
 </section>
 <section class="cp-section cp-why" id="why-corepro"><div class="cp-wrap cp-why-grid"><div class="cp-why-intro cp-reveal"><p class="cp-eyebrow">التفاصيل تصنع فرق التنفيذ</p><h2 class="cp-title">الدقة ليست في القطع فقط.<br />بل في كل ما يسبقه.</h2><p class="cp-intro">نراجع طريقة العمل مع ظروف المكان، ونتفق على نطاق التنفيذ والتجهيزات. فتح العناصر الإنشائية يستلزم مراجعة المهندس المسؤول قبل البدء.</p></div><div class="cp-features">
   <article class="cp-feature cp-reveal"><Ruler size={27} /><h3>مقاسات واستخدام واضح</h3><p>قطر الفتحة وسماكة العنصر ونوع الاستخدام، بدل اختيار مقاس عام لا يناسب التمديد.</p></article><article class="cp-feature cp-reveal"><Layers size={27} /><h3>معدة تناسب طبيعة العمل</h3><p>تحديد الكور أو المنشار أو الواير بعد مراجعة العنصر والوصول وإمكانية تثبيت المعدة.</p></article><article class="cp-feature cp-reveal"><ShieldCheck size={27} /><h3>حماية الموقع والتشطيبات</h3><p>مراجعة الأثاث والكهرباء واحتواء مياه التبريد والمخلفات قبل بدء القص أو التخريم.</p></article><article class="cp-feature cp-reveal"><ClipboardCheck size={27} /><h3>اتفاق قبل التنفيذ</h3><p>توضيح الأعمال والخامات والتكلفة والاستثناءات والموعد وفق تفاصيل كل مشروع.</p></article>
 </div></div></section>
 <section class="cp-section cp-wrap"><div class="cp-project-banner cp-reveal"><div><p class="cp-eyebrow">أعمال وتطبيقات</p><h2>شاهد كيف تختلف متطلبات كل عمل.</h2><p>تصفح أمثلة الخدمات والصور المعروضة في سابقة الأعمال، وراجع الخدمة المناسبة لحالتك قبل إرسال تفاصيل المشروع.</p></div><a class="cp-btn cp-btn-outline" href="/projects">تصفح سابقة الأعمال<ArrowLeft size={18} /></a></div></section>
 <QuickQuote />
 <section class="cp-section cp-wrap" id="work-process"><p class="cp-eyebrow">خطوات العمل</p><h2 class="cp-title mt-3">من أول مقاس… إلى آخر مراجعة.</h2><div class="cp-process">
   <article class="cp-step cp-reveal"><span>01</span><h3>أرسل تفاصيل الموقع</h3><p>نوع العمل والمقاسات وصورة المكان والعنوان والموعد المطلوب.</p></article><article class="cp-step cp-reveal"><span>02</span><h3>مراجعة طريقة التنفيذ</h3><p>تحديد التجهيزات والمعدة والتثبيت والحاجة إلى مراجعة هندسية أو معاينة.</p></article><article class="cp-step cp-reveal"><span>03</span><h3>اتفاق وتجهيز</h3><p>توضيح النطاق والتكلفة والموعد والاستثناءات وحماية المكان.</p></article><article class="cp-step cp-reveal"><span>04</span><h3>تنفيذ ومراجعة</h3><p>تنفيذ النطاق المتفق عليه ومراجعة الفتحة أو القطع وتجهيزات التسليم.</p></article>
 </div></section>
 <div class="cp-home-details">
 {/* Other Sections */}
 <div class="mx-auto max-w-6xl px-4 pb-14 space-y-6">
 {/* Why Choose Us */}
  <section id="request-details" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
 <div class="mb-6 flex items-start gap-3">
 
 <div>
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">ما المعلومات المطلوبة لطلب الخدمة؟</h2>
  <p class="mt-2 text-slate-600 leading-7">تساعد هذه التفاصيل على تقييم طريقة التنفيذ والتكلفة قبل تحديد الموعد.</p>
 </div>
 </div>
 <div class="grid gap-3 md:grid-cols-2">
 {[
   { name: "نوع الخدمة", href: null },
   { name: "المقاسات وسماكة الخرسانة", href: null },
   { name: "صورة أو مخطط للموقع", href: null },
   { name: "عنوان المشروع وموعده", href: null },
 ].map((x) => (
    <div class="flex items-center gap-2 rounded-2xl border border-black/10 bg-white p-4">
      <span class="text-slate-700">{x.name}</span>
    </div>
 ))}
 </div>
 </section>

 {/* Areas */}
 <section id="areas" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
 <div class="mb-6 flex items-start gap-3">
 <div>
 <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">مناطق الخدمة (الأكثر طلباً)</h2>
 <p class="mt-2 text-slate-600 leading-7">اضغط على منطقتك لمعرفة التفاصيل الخاصة بها</p>
 </div>
 </div>
 <div class="grid gap-3 md:grid-cols-2">
 {[
  { name: "التجمع الخامس والقاهرة الجديدة", href: "/concrete-cutting-tagamoa" },
  { name: "6 أكتوبر والشيخ زايد", href: "/concrete-cutting-october" },
  { name: "الإسكندرية والساحل الشمالي", href: "/concrete-cutting-alexandria" },
  { name: "مدينة نصر ومصر الجديدة", href: null },
  { name: "المعادي والشروق ومدينتي", href: null },
  { name: "العاصمة الإدارية الجديدة", href: "/concrete-cutting-new-capital" },
 ].map((x) => (
  x.href ? (
    <a href={x.href} class="flex items-center justify-between rounded-2xl border border-emerald-500/30 bg-emerald-50/50 p-4 hover:bg-emerald-50 transition group">
      <span class="text-emerald-800 font-extrabold">{x.name}</span>
      <ArrowRight className="h-4 w-4 text-emerald-600 rotate-180 group-hover:-translate-x-1 transition-transform" />
    </a>
  ) : (
    <div class="flex items-center gap-2 rounded-2xl border border-black/10 bg-white p-4">
      <span class="text-slate-700">{x.name}</span>
    </div>
  )
 ))}
 </div>
 </section>

   {/* Service contact directory */}
  <section id="directory" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
    <div class="mb-6 flex items-start gap-3">
      <div>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">التواصل حسب نوع الخدمة</h2>
        <p class="mt-2 text-slate-600 leading-7">رقم التواصل ورابط تفاصيل كل خدمة</p>
      </div>
    </div>
    
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-right text-slate-800 min-w-[500px]">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="p-4 font-black text-slate-900">الخدمة المطلوبة</th>
            <th class="p-4 font-black text-slate-900 border-r border-slate-200">رقم التواصل المباشر</th>
            <th class="p-4 font-black text-slate-900 border-r border-slate-200">التفاصيل</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-bold">
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">صنايعي كور / فني تخريم</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/core" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">تخريم بالكور</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">أعمال المقاولات والكميات المتعددة</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/contractor" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">مقاولات الشركات</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">قص الخرسانة بالواير الماسي</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/wire" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">قص الكتل والقواعد</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">قص الجدران والأسقف بالمنشار</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/saw" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">فتح الأبواب والنوافذ</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">منشار قص الخرسانة (Track Saw)</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01021507462" class="hover:underline">01021507462</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/track-saw" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">قص مستقيم بالمنشار</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition">
            <td class="p-4 text-slate-700">فني تركيب شفاطات مطبخ / حمام</td>
            <td class="p-4 border-r border-slate-200 text-sky-700"><a href="tel:01015218216" class="hover:underline">01015218216</a></td>
            <td class="p-4 border-r border-slate-200"><a href="/hoods" class="text-emerald-600 hover:text-emerald-700 underline underline-offset-4">تركيب وتأسيس شفاطات</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

 {/* FAQ */}
 <section id="faq" class="rounded-3xl border border-black/10 bg-white/70 backdrop-blur-xl p-6 md:p-10 shadow-[0_12px_50px_rgba(0,0,0,0.08)]">
  <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">أسئلة شائعة عن القص والتخريم والشفاطات</h2>
  <div class="mt-6 space-y-4">
  {faq.map((item) => (
  <details class="rounded-2xl border border-black/10 bg-white p-5">
    <summary class="cursor-pointer font-bold text-slate-900">{item.q}</summary>
    <p class="mt-4 text-slate-700 leading-8">{item.a}</p>
  </details>
  ))}
  </div>
 <div id="cta" class="mt-8 grid gap-4 md:grid-cols-2 md:items-center">
 <div class="text-slate-700 leading-8">
  <p><strong>{BRAND}</strong> تقدم خدمات قص الخرسانة وتخريم الكور وتركيب الشفاطات. أرسل نوع العمل ومقاساته وموقعه لمراجعة نطاق التنفيذ.</p>
  <p class="mt-3">تُحدد تكلفة العمل بعد مراجعة تفاصيل الموقع والخدمة المطلوبة.</p>
 </div>
 <div class="rounded-3xl border border-black/10 bg-white p-6">
  <div class="font-extrabold text-slate-900">للتواصل وتأكيد التغطية</div>
 <div class="mt-1 text-2xl font-extrabold text-sky-700">{PHONE}</div>
  <div class="mt-4 flex items-center gap-2 text-sm text-slate-600">
 <MapPin className="h-4 w-4" />
  <span>{ADDRESS_TEXT} والجيزة والمدن الجديدة</span>
 </div>
 </div>
 </div>
 </section>
 </div>
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "ImageObject",
      "contentUrl": `https://corepro-eg.com/og-image.webp`,
      "name": "كور برو - قص وتخريم الخرسانة في مصر",
       "description": "قص الخرسانة بالمنشار والواير وتخريم الكور وتركيب الشفاطات",
      "author": { "@type": "Organization", "name": "كور برو - Core Pro", "url": "https://corepro-eg.com" },
      "copyrightHolder": { "@type": "Organization", "name": "كور برو - Core Pro" },
      "creditText": "كور برو - Core Pro",

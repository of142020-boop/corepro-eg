---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Maximize, Phone, ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug);
if (!post) return Astro.redirect('/404');

const { Content } = await render(post);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("ar-EG", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};
---

<Layout title={`${post.data.title} | مدونة كور برو مصر`} description={post.data.description}>
  <article class="min-h-screen bg-white pb-24" dir="rtl">
    
    <header class="bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-5xl px-4 py-12 md:py-20">
        <nav class="mb-8 flex items-center justify-end gap-2 text-sm text-slate-500 font-bold">
          <a href="/" class="hover:text-emerald-600 transition">الرئيسية</a>
          <ChevronRight class="h-4 w-4" />
          <a href="/blog" class="hover:text-emerald-600 transition">المدونة</a>
          <ChevronRight class="h-4 w-4" />
          <span class="text-slate-900 line-clamp-1">{post.data.title}</span>
        </nav>

        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div>
                {post.data.category && (
                    <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-1.5 rounded-full text-xs font-black mb-6">
                        # {post.data.category}
                    </span>
                )}
                <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight border-r-8 border-emerald-600 pr-5">
                    {post.data.title}
                </h1>
                <div class="mt-6 flex items-center justify-end gap-4 text-sm text-slate-500 font-bold">
                    <span>{formatDate(post.data.pubDate)}</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
                    <span>كور برو مصر</span>
                </div>
            </div>

            <div class="relative aspect-square rounded-none border-4 border-white bg-white shadow-2xl overflow-hidden cursor-pointer group" data-lightbox-src={post.data.heroImage}>
                {post.data.heroImage ? (
                    <>
                        <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 rounded-none" />
                        <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                            <Maximize class="h-12 w-12" />
                        </div>
                    </>
                ) : (
                    <div class="w-full h-full bg-slate-100" />
                )}
            </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 pt-16">
      <div class="prose prose-slate prose-lg max-w-none text-right leading-9 text-slate-800">
        <Content />
      </div>

      <div class="mt-20 p-10 rounded-none border-4 border-slate-900 bg-slate-900 text-white shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-48 h-48 bg-emerald-600/20 blur-3xl -mr-24 -mt-24"></div>
        <h3 class="text-3xl font-black mb-4 relative z-10">هل لديك مشروع إنشائي؟</h3>
        <p class="text-slate-300 text-lg mb-8 relative z-10">فريق متخصص بخبرة طويلة في قص وتخريم الخرسانة بكافة أنواعها. تواصل معنا لمعاينة فنية مجانية وعرض سعر.</p>
        
        <div class="flex flex-wrap gap-4 relative z-10">
          <a href="https://wa.me/201055550195" target="_blank" class="flex-1 min-w-[200px] bg-emerald-600 hover:bg-emerald-700 text-white font-black py-5 rounded-none text-center text-xl shadow-lg transition transform hover:-translate-y-1">
             تواصل معنا الآن (واتس اب)
          </a>
          <a href="tel:01055550195" class="flex-1 min-w-[200px] bg-white text-slate-900 font-black py-5 rounded-none text-center text-xl shadow-lg transition hover:bg-slate-50">
             اتصل بنا: 01055550195
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  /* Custom prose for RTL */
  .prose pre { text-align: left; }
  .prose h2 { @apply text-3xl font-black text-slate-900 mt-12 mb-6 border-r-4 border-emerald-500 pr-4; }
  .prose h3 { @apply text-2xl font-black text-slate-900 mt-10 mb-5; }
  .prose p { @apply text-slate-700 mb-6; }
  .prose ul, .prose ol { @apply my-6 pr-6; }
  .prose li { @apply mb-3; }
  .prose img { @apply rounded-none border-4 border-white shadow-lg mx-auto; }
  .prose strong { @apply text-slate-900; }
</style>

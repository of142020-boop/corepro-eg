---
import Layout from "../../layouts/Layout.astro";
import PageComponent from "../../components/pages/corePage";
import BreadcrumbNav from "../../components/BreadcrumbNav.astro";
import { coreService, corePhotos } from '../../lib/core-service';
---

<Layout
  title={coreService.title}
  description={coreService.description}
  canonical={coreService.canonical}
  image={corePhotos[0].src}
  ogImageAlt={corePhotos[0].alt}
>
  <BreadcrumbNav
    items={[
      { label: "الرئيسية", href: "/" },
      { label: "صنايعي كور وتخريم الخرسانة" },
    ]}
  />
  <PageComponent />
</Layout>

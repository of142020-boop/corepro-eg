---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="الصفحة غير موجودة 404 - Core Pro Egypt"
  description="الصفحة التي تبحث عنها غير موجودة وتم تغيير مسارها."
>
  <main class="min-h-[75vh] flex items-center justify-center bg-gray-50 dark:bg-gray-950 py-20 px-6 font-primary text-right" dir="rtl">
    <div class="max-w-3xl w-full text-center space-y-8 bg-white dark:bg-gray-900 p-12 md:p-16 rounded-3xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] dark:shadow-none dark:border border-gray-800 relative xl:overflow-hidden">
      
      <!-- Decorational Ambient Blurs -->
      <div class="absolute -top-32 -right-32 w-64 h-64 bg-red-600/10 dark:bg-red-500/10 rounded-full blur-[80px] pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-blue-600/10 dark:bg-blue-500/10 rounded-full blur-[80px] pointer-events-none"></div>
      
      <!-- 404 Visual element -->
      <div class="relative inline-block select-none py-4">
        <div class="absolute inset-0 bg-red-600/20 blur-3xl rounded-full scale-75 animate-pulse"></div>
        <h1 class="relative text-[120px] md:text-[180px] leading-none font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-red-600 via-red-500 to-orange-400 drop-shadow-sm tracking-tighter">
          404
        </h1>
        <div class="absolute w-full h-1/3 bg-gradient-to-t from-white dark:from-gray-900 to-transparent bottom-0 z-10"></div>
      </div>

      <!-- Thematic Copywriting -->
      <div class="space-y-4 relative z-20">
        <h2 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          عفواً.. يبدو أننا أحدثنا <span class="text-red-500 relative whitespace-nowrap">
            <span class="relative z-10">فتحة عميقة!</span>
            <svg class="absolute w-full h-3 -bottom-1 right-0 text-red-500/30" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="4" fill="none"/></svg>
          </span>
        </h2>
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl mx-auto leading-relaxed">
          لقد قمنا بعمليات قص وتخريم أدت إلى هذا المكان المجهول. ربما تغير رابط الصفحة أو تم حذفها لتوسعة أخرى في الموقع الإنشائي.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-10 relative z-20">
        <a href="/" class="group relative px-8 py-4 rounded-xl overflow-hidden font-bold transition-all w-full sm:w-auto shadow-lg shadow-red-500/20 hover:shadow-red-500/40">
          <div class="absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 transition-all duration-300 group-hover:scale-[1.05]"></div>
          <span class="relative flex items-center justify-center gap-2 text-white">
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
            <span>العودة للصفحة الرئيسية</span>
          </span>
        </a>
        
        <a href="/prices" class="group px-8 py-4 rounded-xl border-2 border-gray-200 dark:border-gray-700 bg-transparent text-gray-800 dark:text-gray-200 font-bold hover:border-red-500 hover:text-red-500 transition-all duration-300 flex items-center justify-center gap-2 w-full sm:w-auto">
          <span>دليل الأسعار</span>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </a>
      </div>
      
      <!-- Footer Support -->
      <div class="pt-10 mt-6 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-800 relative z-20">
        هل واجهت هذه المشكلة أثناء التصفح؟ <a href="https://wa.me/201055550195" target="_blank" class="text-red-600 dark:text-red-500 hover:text-red-700 font-semibold underline underline-offset-4 decoration-red-500/30 transition-colors">أرسل لنا عبر الواتساب</a>
      </div>

    </div>
  </main>
</Layout>

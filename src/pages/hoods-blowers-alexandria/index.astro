---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import { ArrowLeft, Fan, Wind, Ruler, Building2, Wrench, Phone, CheckCircle2 } from 'lucide-react';
import { getPageContact } from '../../lib/contact';
const canonical = 'https://corepro-eg.com/hoods-blowers-alexandria';
const title = 'تركيب وتأسيس الشفاطات والبلاورات في الإسكندرية - 01094496839';
const description = 'فني تركيب شفاط المطبخ بالإسكندرية، تأسيس الدكت وفتحات التهوية، وتركيب بلاورات الشفط وهود المطاعم. أرسل المنطقة وصور الموقع لمراجعة الخدمة والتكلفة: 01094496839.';
const contact = getPageContact('/hoods-blowers-alexandria');
const illustrativePhotos = [
  { file: 'kitchen-wall-hood', alt: 'شفاط مطبخ جداري بمدخنة معدنية فوق سطح الطهي', caption: 'شفاط مطبخ جداري', author: 'Connor Scott McManus', source: 'https://www.pexels.com/photo/exhaust-hood-over-cooker-15119073/' },
  { file: 'ceiling-ventilation-ducts', alt: 'مجاري هواء معدنية ظاهرة ومعلقة أسفل سقف منشأة', caption: 'مجاري الهواء ومسارات التهوية', author: 'Lillian Katrine Kofod', source: 'https://www.pexels.com/photo/photo-of-the-ceiling-with-steel-pipes-12658691/' },
  { file: 'rooftop-exhaust-system', alt: 'تجهيزات تهوية خارجية ومخارج هواء معدنية أعلى مبنى', caption: 'تجهيزات التهوية الخارجية', author: 'Alexander Grigorian', source: 'https://www.pexels.com/photo/ventilation-system-on-roof-of-building-7396978/' },
];
const sections = [
  ['services', 'الخدمات المتاحة'], ['foundation', 'التأسيس قبل التشطيب'],
  ['kitchens', 'شفاط المطبخ والحمام'], ['blowers', 'البلاورات وهود المطاعم'],
  ['local-planning', 'تجهيز الموقع في الإسكندرية'], ['maintenance', 'ضعف السحب والصيانة'],
  ['cost', 'التكلفة ونطاق العمل'], ['request', 'طلب معاينة'], ['faq', 'أسئلة شائعة'],
];
const faqs = [
  { q: 'هل يمكن تركيب شفاط المطبخ في شقة جاهزة بالإسكندرية؟', a: 'تبدأ المراجعة بصور المطبخ وموديل الجهاز والفتحة الحالية إن وجدت. تُحدد إمكانية التثبيت ومسار الهواء وأي تعديل في الوحدات أو الحائط قبل الاتفاق، ولا يُفترض أن كل جهاز يناسب كل مكان.' },
  { q: 'متى أطلب تأسيس مواسير الشفاط والدكت؟', a: 'قبل إغلاق السقف المعلق وتركيب وحدات المطبخ قدر الإمكان، وبعد معرفة موديل الجهاز. يحدد الفني فتحة التركيب ومسار الدكت ومخرج الهواء ونقاط الصيانة بالتنسيق مع النجّار والكهربائي وباقي التشطيبات.' },
  { q: 'هل يكفي اختيار البلاور بعدد الأحصنة؟', a: 'لا؛ يحتاج الاختيار إلى معدل الهواء المطلوب وضغط التشغيل ومقاومة الدكت وطبيعة الهواء ودرجة حرارته. أرسل بيانات المروحة والمخطط أو طول المسار والأكواع ومعدات الطهي لتحديد ما يحتاج مراجعة متخصصة.' },
  { q: 'هل الشفاط بدون مدخنة مناسب إذا تعذر الطرد للخارج؟', a: 'فقط إذا كان الموديل يدعم إعادة التدوير باستخدام الفلاتر والملحقات المخصصة له. هذا الوضع يساعد في تقليل الروائح لكنه لا يطرد رطوبة الطبخ إلى الخارج، ولذلك تُراجع تهوية المكان أيضاً.' },
  { q: 'هل تقدمون صيانة شفاطات وبلاورات في الإسكندرية؟', a: 'يمكن طلب فحص ضعف السحب أو الصوت أو الاهتزاز، وتُؤكد إمكانية الإصلاح بعد معرفة الموديل والعطل وتوافر القطع والوصول للمعدة. يُحدد نطاق الزيارة والتنظيف وقطع الغيار وتكلفتها قبل الموافقة، دون وعد بإصلاح كل جهاز.' },
  { q: 'هل تغطون سموحة وميامي والعجمي وبرج العرب؟', a: 'أرسل العنوان والمنطقة ونوع الخدمة لتأكيد التغطية وتكلفة الانتقال والموعد. تُراجع ترتيبات الدخول والوصول بصورة منفصلة للمواقع البعيدة أو المشروعات في برج العرب؛ ذكر المنطقة لا يعني وجود فرع فيها.' },
  { q: 'كم سعر تركيب الشفاط أو البلاور في الإسكندرية؟', a: 'لا يوجد سعر موحد لكل الحالات. يتأثر السعر بموديل الجهاز والفتحات ومسار الدكت والخامات والارتفاع وسهولة الوصول والكهرباء. اطلب عرضاً يفصل الأجور والخامات والانتقال وأي تعديلات، وسعر الجهاز إن كان التوريد ضمن الاتفاق.' },
  { q: 'هل هذه صفحة توكيل رسمي أو إصدار شهادات للمطاعم؟', a: 'الخدمة مستقلة، وذكر الماركات لا يعني وكالة رسمية أو ضمان المصنع. أي تصميم أو اعتماد أو مستند رسمي مطلوب للمطعم يُراجع مع الجهة المختصة ويُحدد المسؤول عنه قبل التعاقد؛ تركيب النظام لا يضمن صدور ترخيص.' },
  { q: 'ماذا أفعل إذا كان مشروعي في القاهرة أو الجيزة؟', a: 'استخدم صفحة تأسيس وتركيب شفاط المطبخ للقاهرة والجيزة على الرابط /hoods، ورقمها المخصص 01015218216. هذه الصفحة ووسيلة الحجز فيها مخصصتان لطلبات الإسكندرية.' },
];
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Service', '@id': `${canonical}#service`, name: 'تركيب وتأسيس الشفاطات والبلاورات في الإسكندرية', serviceType: ['تركيب شفاط المطبخ', 'تأسيس الدكت والتهوية', 'تركيب بلاورات الشفط وهود المطاعم'], url: canonical, description, areaServed: { '@type': 'City', name: 'الإسكندرية', alternateName: 'Alexandria' }, provider: { '@id': 'https://corepro-eg.com/#organization' }, availableChannel: { '@type': 'ServiceChannel', serviceUrl: canonical, servicePhone: { '@type': 'ContactPoint', telephone: contact.international, contactType: 'حجز خدمات الإسكندرية', availableLanguage: 'Arabic' } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<Layout title={title} description={description} canonical={canonical} geoRegion="EG-ALX" geoPlacename="Alexandria, Egypt" geoPosition="31.2001;29.9187">
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} /></Fragment>
  <BreadcrumbNav items={[{ label: 'الرئيسية', href: '/' }, { label: 'الشفاطات والبلاورات في الإسكندرية' }]} />
  <div class="alex-hoods">
    <section class="alex-hero"><div class="cp-wrap alex-hero-grid">
      <div><p class="cp-eyebrow">خدمات الشفاطات والتهوية · الإسكندرية</p><h1>{title}</h1><p class="alex-lead">لشقة تحت التشطيب، أو مطبخ جاهز، أو مطعم يحتاج مراجعة نظام السحب: نبدأ بموديل الجهاز ومسار الهواء وظروف الموقع. تشمل الطلبات تأسيس مواسير الشفاط والدكت، وتجهيز الفتحات، وتركيب شفاط المطبخ والبلاور بحسب النطاق الذي تؤكده المعاينة.</p><div class="cp-actions"><a class="cp-btn cp-btn-orange" href="#request">أرسل طلبك في الإسكندرية<ArrowLeft size={18} /></a><a class="cp-btn cp-btn-outline" href={`tel:${contact.international}`}><Phone size={17} /><bdi>{contact.phone}</bdi></a></div><p class="alex-small">تأكيد التغطية والتكلفة والموعد بعد مراجعة المنطقة والتفاصيل.</p></div>
      <aside class="alex-planning-card" aria-label="مراجعة مكونات نظام التهوية"><div class="alex-air-art" aria-hidden="true"><svg viewBox="0 0 360 230" fill="none"><defs><pattern id="alex-grid" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0V22" stroke="#ffffff08"/></pattern></defs><rect width="360" height="230" fill="url(#alex-grid)"/><path d="M85 128V65h175v28" stroke="#475569" stroke-width="30"/><path d="M85 128V65h175v28" stroke="#38bdf8" stroke-width="2" stroke-dasharray="5 7"/><path d="m38 155 30-30h37l31 30v13H38Z" fill="#94a3b8" stroke="#e2e8f0"/><path d="M38 160h98v8H38Z" fill="#334155"/><path d="m52 165 5-4m8 4 5-4m8 4 5-4m8 4 5-4m8 4 5-4m8 4 5-4" stroke="#cbd5e1"/><rect x="228" y="90" width="64" height="67" rx="8" fill="#1e293b" stroke="#94a3b8"/><circle cx="260" cy="122" r="23" stroke="#38bdf8"/><path d="M260 122q-23-19-12-21 15-1 12 21m0 0q19-23 21-12 1 15-21 12m0 0q23 19 12 21-15 1-12-21m0 0q-19 23-21 12-1-15 21-12" fill="#0ea5e9"/><circle cx="260" cy="122" r="4" fill="#fff"/><path d="M148 59v17m19-17v17m19-17v17m-115 106v22m15-22v22m15-22v22m208-95h25m-25 14h20m-20 14h25" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 5"/></svg></div><h2>من الفتحة إلى مخرج الهواء</h2><ul><li><CheckCircle2 size={17} />مطابقة الجهاز والفتحة والوحدة</li><li><CheckCircle2 size={17} />مراجعة مسار الدكت وهواء التعويض</li><li><CheckCircle2 size={17} />تثبيت مناسب وإمكانية وصول للصيانة</li></ul><p>الرسم توضيحي؛ الاختيار الفني ومقاسات التنفيذ تُراجع حسب كل موقع.</p></aside>
    </div></section>
    <div class="cp-wrap alex-body-grid">
      <article class="alex-article">
        <nav class="alex-toc" aria-label="محتويات صفحة شفاطات الإسكندرية"><b>انتقل إلى ما يهمك</b><div>{sections.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</div></nav>
        <section class="alex-photo-section" aria-labelledby="alex-photo-heading">
          <h2 id="alex-photo-heading">الشفاط والدكت ومخرج الهواء: أمثلة توضيحية</h2>
          <p>صور توضيحية لأنواع التجهيزات، وليست صورًا لمشروعات نفذتها كور برو أو لمواقع في الإسكندرية. يختلف الجهاز والمسار المناسبان حسب المعاينة.</p>
          <div class="alex-photo-grid">{illustrativePhotos.map(photo => <figure>
            <img src={`/images/hoods-alexandria/${photo.file}-900.webp`} srcset={`/images/hoods-alexandria/${photo.file}-480.webp 480w, /images/hoods-alexandria/${photo.file}-900.webp 900w`} sizes="(max-width: 800px) calc(100vw - 80px), 240px" width="900" height="675" loading="lazy" decoding="async" alt={photo.alt} />
            <figcaption><strong>{photo.caption}</strong><span>تصوير <a href={photo.source} target="_blank" rel="noopener noreferrer">{photo.author} · Pexels</a></span></figcaption>
          </figure>)}</div>
        </section>
        <section id="services"><p class="cp-eyebrow">اختر نطاق طلبك</p><h2>خدمات الشفاطات والبلاورات للمنازل والمطاعم</h2><div class="alex-service-grid">
          <div class="alex-card"><Ruler size={25} /><h3>تأسيس الدكت والفتحات</h3><p>مراجعة مسار المواسير ومقاس المخرج قبل السيراميك والجبس، وتنسيق فتحة الكور عند الحاجة بعد التأكد من صلاحية موضعها.</p></div>
          <div class="alex-card"><Fan size={25} /><h3>تركيب شفاط المطبخ والحمام</h3><p>بلت إن أو هرمي أو مسطح أو جهاز على الشباك، مع مطابقة تعليمات الموديل ووضع التشغيل ونوع سطح التثبيت.</p></div>
          <div class="alex-card"><Wind size={25} /><h3>تركيب بلاور شفط وطرد</h3><p>مراجعة بيانات المروحة وشبكة الدكت وطبيعة الهواء قبل تحديد المعدة أو طريقة التعليق والتوصيلات.</p></div>
          <div class="alex-card"><Wrench size={25} /><h3>فحص وتنظيف النظام</h3><p>تحديد سبب ضعف السحب أو الاهتزاز، وفصل أعمال التنظيف والإصلاح وقطع الغيار في عرض واضح بعد الفحص.</p></div>
        </div></section>
        <section id="foundation"><h2>تأسيس شفاط المطبخ قبل التشطيب في الإسكندرية</h2><p>إذا كانت الشقة أو الفيلا في مرحلة المحارة، جهز رقم موديل الشفاط ومخطط المطبخ قبل تحديد مسار الدكت. يراجع الفني أبعاد الوحدة، وموضع البوتاجاز، ومخرج الهواء، والتعارضات مع مواسير المياه والكهرباء. تركيب شفاط بلت إن مخفي يحتاج تنسيقًا مع النجّار، وليس مجرد إخفاء المواسير داخل الجبس.</p><ol><li><strong>تحديد المخرج:</strong> هل يوجد مسار طرد مسموح إلى الخارج؟ وهل يمر داخل سقف معلق أو يتطلب تعديلًا في الواجهة؟ راجع موافقات المبنى قبل التنفيذ.</li><li><strong>تحديد المقاسات:</strong> قطر الدكت وفتحة القص ومسافة التثبيت فوق سطح الطهي تؤخذ من تعليمات الموديل والتصميم، ولا توجد أبعاد واحدة لكل الأجهزة.</li><li><strong>تجهيز الفتحة:</strong> عند الحاجة إلى تخريم الخرسانة، تُراجع الخدمات المخفية ودور الجدار أو البلاطة وموافقة المهندس المسؤول للعناصر الإنشائية.</li><li><strong>ترك مساحة للصيانة:</strong> لا تُغلق الوصلات والفلاتر والمروحة خلف تشطيب يمنع الوصول إليها، وحدد مع المنفذ ما يمكن فكه لاحقًا.</li></ol><p>في الموقع المشطب تُراجع حماية السيراميك والأثاث وتجميع مياه التبريد والمخلفات قبل استخدام الكور. لا يُوعد بعدم تأثر أي تشطيب دون معاينة حالته. لأعمال الفتحات وحدها راجع <a href="/concrete-cutting-alexandria">تخريم الكور وقص الخرسانة في الإسكندرية</a>.</p></section>
        <section id="kitchens"><h2>فني تركيب شفاط مطبخ: بلت إن، هرمي، مسطح أو شباك</h2><p>شكل الشفاط لا يحسم نظام تشغيله. بعض الموديلات تعمل بطرد خارجي، وبعضها يدعم إعادة تدوير الهواء بفلاتر وملحقات محددة، وقد يدعم الجهاز الوضعين. نراجع الموديل أولًا بدل افتراض أن كل شفاط مسطح يعمل دون مدخنة أو أن كل جهاز بلت إن يركب داخل أي وحدة.</p><div class="alex-comparison"><div><h3>الطرد الخارجي</h3><p>ينقل الهواء إلى الخارج عبر دكت ومخرج مناسبين. يُراجع قطر الماسورة والأكواع وإحكام الوصلات وبوابة منع الرجوع عند الحاجة، مع التأكد من توافر هواء بديل للمكان.</p></div><div><h3>إعادة التدوير بالفلاتر</h3><p>تعيد الهواء إلى الغرفة بعد مروره بالفلاتر المناسبة للموديل. تساعد في تقليل الروائح لكنها لا تطرد رطوبة الطبخ للخارج، ولا تعالج وحدها كل مشاكل تهوية المطبخ.</p></div></div><p>لتركيب شفاط على الشباك، أرسل نوع الزجاج وأبعاده؛ تجهيز الزجاج ينفذه المختص، والزجاج المقسّى لا يُقص داخل الموقع. وفي الحمام تُراجع ملاءمة الجهاز ومكان الكهرباء والحماية المطلوبة قرب مصادر المياه، ولا يطرد الهواء داخل فراغ سقف مغلق.</p><p>يمكن مراجعة تركيب أجهزة توشيبا أو فريش أو تورنيدو أو غيرها بعد إرسال الموديل، دون ادعاء أننا توكيل رسمي لأي علامة. إذا كانت خدمتك في القاهرة أو الجيزة استخدم <a href="/hoods">صفحة تركيب وتأسيس شفاط المطبخ للقاهرة والجيزة</a>.</p></section>
        <section id="blowers"><h2>تركيب البلاورات وهود المطاعم والكافيهات بالإسكندرية</h2><p>المطعم يحتاج منظومة لالتقاط أبخرة الطهي ونقلها وطردها، وليس اختيار بلاور كبير فقط. تبدأ المراجعة بنوع معدات الطهي، وأبعاد الهود، والفلاتر، وطول الدكت وأكواعه، ومكان المروحة ومخرج الطرد. ويُوضح ما يحتاج تصميمًا أو اعتمادًا من مسؤول المشروع قبل التوريد.</p><h3>ما بيانات اختيار بلاور الشفط والطرد؟</h3><ul><li>معدل تدفق الهواء وضغط التشغيل المطلوبان عند نقطة التشغيل، وليس القدرة بالحصان أو الواط وحدها.</li><li>نوع الهواء: محمل بالدهون أو الرطوبة أو الأتربة، ودرجة الحرارة المتوقعة وتوافق المعدة معها.</li><li>موقع المروحة وقواعدها والاهتزاز والضوضاء وإمكانية وصول فريق التنظيف والصيانة.</li><li>هواء التعويض ومسار الطرد ومخارج الهواء، لتجنب خلل سحب المكان أو انتقال الروائح للمجاورين.</li></ul><p>نطاق تصنيع أو تركيب الدكت والهود والخامات والبلاور يُحدد في العرض، وتُراجع متطلبات أنظمة الحريق والكهرباء والموافقات مع المختصين. تطبيقات المصانع التي تتضمن أبخرة خطرة أو قابلة للاشتعال تحتاج معدات وتصميمًا مخصصين؛ لا تعامل كتركيب شفاط منزلي. لا تشمل خدمة التركيب تلقائيًا إصدار شهادة أو ترخيص رسمي.</p></section>
        <section id="local-planning"><h2>ما الذي نراجعه في موقعك داخل الإسكندرية؟</h2><p>أرسل المنطقة مثل سموحة أو سيدي جابر أو سيدي بشر أو ميامي أو المنتزه أو العجمي، مع عنوان واضح ونقطة الموقع عند التواصل لتأكيد إمكانية الوصول. للمشروعات في برج العرب أو المواقع الأبعد، تُراجع مسافة الانتقال ومدخل التحميل ومواعيد الدخول على حدة. هذه مناطق للاستفسار عن التغطية، وليست عناوين فروع معلنة.</p><div class="alex-service-grid"><div class="alex-card"><Building2 size={23} /><h3>الشقق والمباني القائمة</h3><p>حدد الطابق ووجود مصعد وطبيعة الواجهة ومسار الدكت القائم. مرور المسار بمنور أو سطح مشترك يحتاج مراجعة صلاحية المسار وموافقات المبنى، ولا يُفترض أنه متاح لكل شقة.</p></div><div class="alex-card"><Wind size={23} /><h3>الأجزاء الخارجية</h3><p>إذا كانت المروحة أو الوصلات في موضع مكشوف للرطوبة والهواء الخارجي، تُراجع حماية المعدات والخامة والتثبيت وتعليمات الشركة المصنّعة وفق ظروف الموقع الفعلية.</p></div></div><p>في المطاعم الموجودة أسفل وحدات سكنية، وضّح مكان مخرج الطرد وقربه من النوافذ والوحدات المجاورة، وأرسل صور الطريق إلى السطح. وفي الفيلا تحت التشطيب، أرسل مخطط السقف ومساحة وحدة الشفاط قبل إغلاق الجبس. هذه التفاصيل تساعد على مناقشة بدائل قابلة للتنفيذ بدل تغيير المسار بعد انتهاء التشطيب.</p></section>
        <section id="maintenance"><h2>ضعف سحب الشفاط أو صوت البلاور: متى تحتاج فحصًا؟</h2><p>قد يرتبط ضعف السحب بفلتر متسخ أو مجرى مسدود أو بوابة لا تفتح أو مسار غير مناسب، وليس بالضرورة تلف الموتور. إذا بدأ الضعف منذ التركيب، فاذكر ذلك؛ أما إذا ظهر تدريجيًا فأرسل تاريخ آخر تنظيف وحالة الفلاتر وسرعات التشغيل المتأثرة.</p><p>الاهتزاز يحتاج مراجعة التثبيت وحالة المروحة والأجزاء المتحركة بواسطة المختص. لا تُفتح الكهرباء أو المروحة أثناء التشغيل. وعند وجود رائحة احتراق أو شرر أو سخونة غير طبيعية، أوقف الجهاز وافصل التغذية إن أمكن بأمان واطلب فحصًا.</p><p>تنظيف فلاتر الدهون يختلف عن فلاتر الكربون؛ ليست كل فلاتر الكربون قابلة للغسل. تُتبع تعليمات الموديل، ويحدد عرض صيانة الشفاط أو البلاور ما يشمله من تشخيص وتنظيف وأجزاء وضمان مكتوب إن وجد. توافر قطع الغيار وإمكانية الإصلاح يُؤكدان قبل الاتفاق.</p></section>
        <section id="cost"><h2>تكلفة تأسيس وتركيب الشفاطات والبلاورات بالإسكندرية</h2><p>سعر الجهاز ليس هو أجرة التركيب، وسعر متر الدكت وحده لا يمثل تكلفة النظام. لا ننشر رقمًا موحدًا لحالات تختلف في الفتحات والخامات والارتفاعات. تساعدك البنود التالية على طلب عرض يمكن مراجعته ومقارنته:</p><div class="alex-table-wrap"><table><caption>بنود توضيح عرض السعر قبل بدء العمل</caption><thead><tr><th scope="col">البند</th><th scope="col">المعلومات المطلوبة</th></tr></thead><tbody><tr><th scope="row">الجهاز أو البلاور</th><td>الموديل والبيانات الفنية، وهل الجهاز لديك أم تريد مراجعة التوريد ضمن الطلب.</td></tr><tr><th scope="row">الفتحات والتشطيبات</th><td>وجود فتحة سابقة، مادة الحائط أو الزجاج، وأي أعمال تعديل أو حماية للموقع.</td></tr><tr><th scope="row">الدكت والخامات</th><td>الطول والأبعاد والأكواع والعزل والوصلات والمخارج ونقاط التنظيف.</td></tr><tr><th scope="row">الوصول والكهرباء</th><td>الطابق والوصول للسطح أو الواجهة، ونطاق التثبيت والكهرباء ومسؤولية كل طرف.</td></tr><tr><th scope="row">المعاينة والانتقال</th><td>المنطقة وتكلفة الزيارة إن وجدت، والموعد المتوقع وما إذا كانت المعاينة تخصم من التنفيذ.</td></tr></tbody></table></div><p>اطلب فصل الأجور عن الخامات وقطع الغيار والانتقال، وبيان الأعمال المستثناة وشروط الضمان إن وجدت. أي سعر مبدئي بالصور يخضع لتأكيد النطاق بعد مراجعة ما لا تظهره الصور.</p></section>
        <section id="request"><h2>اطلب معاينة شفاط أو بلاور في الإسكندرية</h2><p>جهز صورة عامة للمكان وصورة الموديل أو لوحة بيانات المروحة، ثم أرسل المنطقة ونوع الطلب. في المطاعم أضف قائمة معدات الطهي وصور الهود والمسار الحالي، وفي الشقق أضف أبعاد وحدة الشفاط ومكان مخرج الهواء.</p><form id="alex-request-form" class="alex-form" action={contact.whatsapp} method="get" data-phone={contact.international.slice(1)}><div><label for="alex-place">نوع الموقع</label><select id="alex-place" name="place"><option>شقة أو مطبخ منزلي</option><option>فيلا تحت التشطيب</option><option>مطعم أو كافيه</option><option>مصنع أو منشأة</option></select></div><div><label for="alex-service">الخدمة المطلوبة</label><select id="alex-service" name="service"><option>تأسيس دكت وفتحة شفاط</option><option>تركيب شفاط مطبخ أو حمام</option><option>تركيب بلاور وهود مطعم</option><option>فحص وصيانة ضعف السحب</option></select></div><div class="alex-form-area"><label for="alex-area">المنطقة داخل الإسكندرية</label><input id="alex-area" name="area" required maxlength="120" autocomplete="address-level2" placeholder="اكتب المنطقة لتأكيد التغطية" /></div><p id="alex-form-notice" class="alex-form-area alex-small">يفتح النموذج رسالة واتساب لتراجعها وترسلها بنفسك؛ لا يؤكد حجزًا تلقائيًا. تجنب كتابة بيانات حساسة. تُرفق الصور داخل المحادثة بعد فتحها.</p><button class="cp-btn cp-btn-orange alex-form-area" type="submit" disabled aria-describedby="alex-form-notice">راجع طلبك على واتساب الإسكندرية<ArrowLeft size={17} /></button><noscript><a class="underline" href={contact.whatsapp}>افتح واتساب مباشرة وأرسل التفاصيل.</a></noscript></form></section>
        <section id="faq"><h2>أسئلة عن تركيب الشفاطات والبلاورات بالإسكندرية</h2>{faqs.map(item => <details class="alex-faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
        <section class="alex-city-link"><h2>الخدمة خارج الإسكندرية؟</h2><p>للقاهرة والجيزة والمدن الجديدة راجع <a href="/hoods">تأسيس وتركيب شفاط المطبخ بالقاهرة والجيزة</a> واتصل بالقسم المخصص على <bdi>01015218216</bdi>. لطلبات الإسكندرية استخدم أزرار التواصل في هذه الصفحة.</p></section>
      </article>
      <aside class="alex-sidebar"><div class="alex-card"><p class="cp-eyebrow">قسم الإسكندرية</p><h2>قبل تحديد الموعد</h2><ul><li>المنطقة ونوع المكان</li><li>الموديل وصور الموقع</li><li>تأسيس جديد أم تعديل قائم؟</li><li>الفتحة ومسار الطرد المتاح</li></ul><a class="cp-btn cp-btn-orange" href={contact.whatsapp}>أرسل الصور والتفاصيل</a><a class="alex-side-phone" href={`tel:${contact.international}`}><Phone size={17} /><bdi>{contact.phone}</bdi></a><p class="alex-small">خدمة مستقلة؛ تأكيد النطاق والتغطية والتكلفة قبل الحجز.</p></div><div class="alex-card"><h2>أدلة تساعدك على الاختيار</h2><a href="/blog/chimney-vs-carbon-filter-hood">الطرد الخارجي أم فلتر الكربون؟</a><a href="/blog/hoods-installation-expert">تجهيز تركيب شفاط المطبخ</a><a href="/concrete-cutting-alexandria">خدمات فتحات الكور بالإسكندرية</a><a href="/hoods">تركيب الشفاطات بالقاهرة والجيزة</a></div></aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#alex-request-form');
  const place = document.querySelector<HTMLSelectElement>('#alex-place');
  const service = document.querySelector<HTMLSelectElement>('#alex-service');
  const area = document.querySelector<HTMLInputElement>('#alex-area');
  const button = form?.querySelector<HTMLButtonElement>('button[type=submit]');
  if (form && place && service && area && button) {
    button.disabled = false;
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!area.value.trim()) { area.setCustomValidity('اكتب المنطقة داخل الإسكندرية لتأكيد التغطية.'); area.reportValidity(); return; }
      area.setCustomValidity('');
      if (!form.reportValidity()) return;
      const message = ['طلب شفاطات وبلاورات من صفحة الإسكندرية — كور برو', `نوع الموقع: ${place.value}`, `الخدمة: ${service.value}`, `المنطقة: ${area.value.trim()}`, 'سأرسل الصور والمقاسات. أرجو تأكيد التغطية وتكلفة المعاينة ونطاق التنفيذ.'].join('\n');
      window.location.assign(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`);
    });
    area.addEventListener('input', () => area.setCustomValidity(''));
  }
</script>
